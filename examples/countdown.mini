// Final-demo style program: compiled and run by our own compiler.
func power(int base, int exp) : int {
    int result = 1;
    for (int i = 0; i < exp; i = i + 1) {
        result = result * base;
    }
    return result;
}

func isEven(int n) : bool {
    return n % 2 == 0;
}

func sumTo(int n) : int {
    int total = 0;
    int i = 1;
    while (i <= n) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

func main() : void {
    print("=== MiniLang demo ===");
    print("2^10      = ", power(2, 10));
        print("sum 1..100 = ", sumTo(100));
    for (int n = 5; n > 0; n = n - 1) {
        if (isEven(n)) {
            print(n, " is even");
        } else {
            print(n, " is odd");
        }
    }
    print("Liftoff!");
}