// Block scoping and shadowing.
func main() : void {
    int x = 1;
    print("outer x = ", x);
    {
        int x = 2;
        print("inner x = ", x);
        {
            int x = 3;
            print("innermost x = ", x);
        }
        print("inner x again = ", x);
    }
    print("outer x again = ", x);
    for (int i = 0; i < 2; i = i + 1) {
        int x = 100 + i;
        print("loop x = ", x);
    }
    print("outer x at end = ", x);
}
