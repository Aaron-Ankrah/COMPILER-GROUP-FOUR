// Fibonacci two ways: recursive and iterative.
func fibRec(int n) : int {
    if (n < 2) { return n; }
    return fibRec(n - 1) + fibRec(n - 2);
}

func fibIter(int n) : int {
    int a = 0;
    int b = 1;
    for (int i = 0; i < n; i = i + 1) {
        int next = a + b;
        a = b;
        b = next;
    }
    return a;
}

func main() : void {
    for (int i = 0; i <= 15; i = i + 1) {
        print("fib(", i, ") recursive=", fibRec(i), " iterative=", fibIter(i));
    }
}
